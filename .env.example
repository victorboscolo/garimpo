# Copie este arquivo para .env e preencha com valores reais.
# NUNCA versione o .env real.

AMBIENTE=local

# Postgres
POSTGRES_USER=garimpo
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=garimpo
DATABASE_URL=postgresql+asyncpg://garimpo:troque_esta_senha@postgres:5432/garimpo

# Auth
JWT_SECRET=troque_este_segredo
JWT_EXPIRATION_MINUTES=480

# Chave fixa usada só por scripts/coletores locais (nunca por humano no
# painel) — Livelo, Esfera, Azul, Smiles, LATAM, e os scripts de
# recalibração/saúde/backup via launchd. Gere algo aleatório, ex:
# `openssl rand -hex 32`.
COLETOR_API_KEY=troque_esta_chave

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CANAL_PUBLICO_ID=
TELEGRAM_CANAL_AVANCADO_ID=
